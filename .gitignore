# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# --- Virtualenvs ---
.venv/
packages/local-app/.venv/

# --- Build / packaging output ---
dist/
build/
*.app/
packages/local-app/build/
packages/local-app/dist/
packages/local-app/dist-release/
packages/local-app/*.spec

# Exception: the tldraw island's esbuild config is SOURCE (it regenerates the
# committed vendor bundle) and must be tracked — the bare `build/` rule above
# would otherwise hide it. node_modules + lockfile stay ignored (global rules
# + the dir's own .gitignore).
!packages/core-ui/static/modules/tldraw/build/
!packages/core-ui/static/modules/tldraw/build/**
packages/core-ui/static/modules/tldraw/build/node_modules/
# Same for the Bryntum island. Its licence key lives only in the gitignored
# license.local.js (written from the env or keychain by build/write-license.mjs).
# The bundle is built from Bryntum's commercial trial package at build time
# (`make bryntum`) and is never committed. The lockfile is committed: it pins
# the trial package and its integrity hash for `npm ci`.
!packages/core-ui/static/modules/bryntum/build/
!packages/core-ui/static/modules/bryntum/build/**
packages/core-ui/static/modules/bryntum/build/node_modules/
packages/core-ui/static/modules/bryntum/license.local.js
packages/core-ui/static/modules/bryntum/vendor/

# --- Tooling caches ---
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node (only if a JS toolchain is added) ---
node_modules/

# --- Cloned/scratch repos pulled by research tooling ---
.repos/

# --- OS / editor cruft ---
.DS_Store
*.swp
*.tmp
*~
.idea/
.vscode/

# --- Playwright MCP scratch ---
.playwright-mcp/

# --- Vercel project link (scripts/deploy-web.sh links the repo root) ---
.vercel/

# NOTE: packages/core-ui/static/vendor/ is intentionally NOT ignored.
# Vendored libraries are committed so the app works offline.
# They are excluded from linters/formatters via tool config instead.

# tldraw drawing-eval screenshots (regenerated by `make tldraw-eval`)
tests/e2e/_tldraw_eval/

# Raw 1.3 MB export; refetch from the URL in its README.
data/ai-engineer-worldsfair-2026/llms-full.md
.vercel
